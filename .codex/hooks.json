{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/check.mjs",
            "timeout": 120,
            "statusMessage": "gleam check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/gate.mjs",
            "timeout": 300,
            "statusMessage": "gleam check, test and format"
          }
        ]
      }
    ]
  }
}
